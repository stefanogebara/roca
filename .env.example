# Stevi — variáveis de ambiente
#
# Ordem: primeiro o que é OBRIGATÓRIO pro produto responder um produtor,
# depois canais, depois prospecção, depois ajustes opcionais. Cada bloco diz o
# que acontece se ficar vazio — nada aqui falha em silêncio por acidente.
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. OBRIGATÓRIAS — sem estas o produto não funciona
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter (uma chave, todos os tiers de modelo).
# Onde: openrouter.ai → Keys. Vazio = nenhuma resposta é gerada.
OPENROUTER_API_KEY=

# Supabase (service role — o compute é stateless, o estado vive aqui).
# Onde: dashboard do projeto → Settings → API. A service_role ignora RLS:
# NUNCA exponha no cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth dos crons (a Vercel envia "Authorization: Bearer <CRON_SECRET>").
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 2. TRANSPORTE WhatsApp — Twilio e Meta Cloud coexistem na MESMA URL
#    (o webhook escolhe o adapter pelo formato da requisição)
# ─────────────────────────────────────────────────────────────────────────────

# Twilio WhatsApp Sandbox (LEGADO — mantido, não desligue)
# Dois motivos pra continuar preenchido: é o rollback do Cloud (mesma URL, sem
# redeploy) e é o que registra número novo na Meta — ela liga e fala o código,
# o Twilio grava e transcreve (api/twiml-otp.ts), porque fixo BR de voz não
# recebe SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (transporte ATIVO — todo inbound entra por aqui)
# Onde: developers.facebook.com → seu app → WhatsApp → API Setup.
# WHATSAPP_APP_SECRET fica em Configurações básicas do app (verifica a
# assinatura X-Hub-Signature-256 do webhook — sem ele, nada é aceito).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ID da conta WhatsApp Business. Opcional: sem ele, é derivado dos escopos do
# token (uma chamada a mais no canário). Defina para poupar a chamada.
WHATSAPP_WABA_ID=

# Número público da Stevi (só dígitos, com DDI). É a fonte ÚNICA do número no
# QR, no cartão .vcf, no rodapé dos cards e nas legendas compartilháveis —
# quando o +55 chegar, trocar aqui troca em todo lugar.
# Vazio = cai no número atual embutido no código (nada quebra).
PUBLIC_WA_NUMBER=19705509125

# URL pública do deploy — base de todo link que a Stevi manda (cards, relatórios,
# /verificar). Vazio = https://roca-black.vercel.app.
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 3. AVISO AOS FUNDADORES — lead quente e incidente
# ─────────────────────────────────────────────────────────────────────────────

# E-mails dos fundadores para lead quente (opt-in de agrônomo e PRIMEIRA
# resposta de prospect). Separados por vírgula — os DOIS, para qualquer um
# assumir a conversa. Cai para REFERRAL_NOTIFY_TO e depois GMAIL_USER.
FOUNDER_NOTIFY_TO=

# Legado, mantido por compatibilidade: destino único do e-mail de referral.
# Prefira FOUNDER_NOTIFY_TO.
REFERRAL_NOTIFY_TO=

# Envio de e-mail via Gmail SMTP. GMAIL_APP_PASSWORD é uma SENHA DE APP
# (16 caracteres), não a senha da conta: myaccount.google.com/apppasswords
# (exige verificação em duas etapas ligada). Vazio = nenhum e-mail sai, e o
# lead fica só no painel/DB.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Canal de alerta INDEPENDENTE do WhatsApp — é por onde vocês ficam sabendo
# quando o próprio WhatsApp cai. Aceita webhook do Discord ou do Slack (o
# payload manda `content` e `text`, os dois formatos). Vazio = o alerta tenta
# o WhatsApp dos fundadores e, falhando, vira log.
ALERT_WEBHOOK_URL=

# Números pessoais dos fundadores (E.164, sem "whatsapp:"), separados por
# vírgula — recebem ping de lead quente e de incidente. Precisam ter entrado
# no sandbox do Twilio enquanto ele for o transporte.
FOUNDER_WA_NUMBERS=

# Número do fundador (E.164) que recebe o digest diário. Vazio = o digest é
# gerado e guardado, só não é enviado.
FOUNDER_WHATSAPP=

# ─────────────────────────────────────────────────────────────────────────────
# 4. ALERTAS PROATIVOS (geada, queimada, vazio sanitário)
# ─────────────────────────────────────────────────────────────────────────────

# Template UTILITY aprovado, usado quando o produtor está FORA da janela de 24h
# da Meta (dentro da janela o texto vai livre e de graça). Um parâmetro {{1}}
# com o texto do alerta. Categoria UTILITY, não Marketing: ~9× mais barato e
# imune ao limite de marketing por usuário. Vazio = alerta fora da janela é
# pulado com log alto (um envio livre seria rejeitado pela API de qualquer jeito).
# Sugestão de corpo: "Stevi 🌱 aviso da sua lavoura: {{1}}"
WHATSAPP_TEMPLATE_ALERT=

# ─────────────────────────────────────────────────────────────────────────────
# 5. PÁGINA DE VERIFICAÇÃO (/verificar) — a âncora de confiança
#    Blocos vazios SOMEM da página: ela nunca inventa um responsável ou CREA.
# ─────────────────────────────────────────────────────────────────────────────

VERIFIER_RESPONSIBLE=
VERIFIER_AGRONOMO=
VERIFIER_CREA=
VERIFIER_LGPD_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# 6. PAINEL DE OPERAÇÃO (/painel) e LINKS ASSINADOS
# ─────────────────────────────────────────────────────────────────────────────

OPS_PASSWORD=
# Chave HMAC do cookie de sessão. Defina INDEPENDENTE do CRON_SECRET (hoje ela
# cai nele com um warning), para que rotacionar um não derrube o outro.
OPS_SESSION_SECRET=
# Mude para qualquer valor novo para revogar todas as sessões do painel de uma vez.
OPS_TOKEN_VERSION=1

# Assina os links do caderno de aplicações (dado químico privado do produtor) E
# as URLs dos cards (anti-forgery: sem assinatura válida, /api/card responde 403).
# ATENÇÃO: trocar este valor invalida NA HORA todo PDF e card já enviado a um
# produtor. Gere uma vez e não rotacione sem motivo:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REPORT_URL_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 7. PROSPECÇÃO (agente Vitória) — leia o post-mortem antes de religar:
#    .claude/plans/2026-07-25-dispatch-postmortem/README.md
# ─────────────────────────────────────────────────────────────────────────────

# Quais tipos de prospect recebem envio (csv, ou 'all'). O default mantém
# coops/revendas FORA até o template de distribuição (stevi_parceria_coop_v1)
# estar aprovado — o pitch de lead-gen soa como ameaça competitiva pra elas.
PROSPECT_SEND_KINDS=agronomo,consultoria

# Override do teto diário. Normalmente VAZIO: o cap é graduado pela saúde do
# número (entrega/falha/opt-out na semana — api/_lib/prospect/health.ts).
# 0 = parada de emergência. ATENÇÃO: enquanto estiver definido, o termômetro
# de saúde é ignorado por inteiro — incluindo a pausa automática.
PROSPECT_DAILY_CAP=

# Nomes dos templates aprovados na Meta, por tipo de prospect.
PROSPECT_TEMPLATE_NAME=stevi_parceria_v2
PROSPECT_COOP_TEMPLATE_NAME=stevi_parceria_coop_v1
PROSPECT_BUMP_TEMPLATE_NAME=stevi_parceria_bump

# Nome da agente nas conversas de prospecção (default: Vitória).
PROSPECT_AGENT_NAME=

# Cadência do funil, em dias: quando o bump D+3 sai, e quando um prospect sem
# resposta vira 'stale'.
PROSPECT_BUMP_AFTER_DAYS=3
PROSPECT_STALE_AFTER_DAYS=14

# Início da janela de saúde (ISO). Existe para ignorar envios que o termômetro
# não consegue julgar com justiça.
#
# Motivo original: sends anteriores ao rastreamento de status nunca passam de
# 'sent' (a Meta não reenvia callback antigo) e contariam como falha, disparando
# pausa fantasma.
#
# Segundo uso, e o valor em produção hoje — 2026-08-03T20:39:54Z, o deploy do
# a5adac3: aquele commit parou de enviar para número sem citação, e as 15 falhas
# da janela de 7 dias vinham TODAS do regime anterior (discar o fixo do cadastro,
# 3 de 3 voltando 131026). Taxa de falha 41% contra um limiar de pausa de 25% —
# o número novo seria condenado pelo comportamento do método morto. Mesmo
# raciocínio do reset de enrich_tried_at no mesmo dia: veredito pertence ao
# método que o produziu.
#
# O QUE ISSO CUSTA, e é preciso saber: com o piso recém-movido a janela fica com
# 0 envios, abaixo do mínimo de 20, então o grau vira 'warming' e o termômetro
# não julga nada até acumular 20 sends. Quem segura o risco nesse intervalo é o
# breaker intradiário (3 falhas pós-aceite), que conta o dia direto e NÃO depende
# desta variável. Mover este piso sem esse breaker de pé seria desligar a
# proteção, não recalibrá-la.
PROSPECT_HEALTH_SINCE=

# Google Places — origem dos prospects (contato comercial público).
# Onde: console.cloud.google.com → APIs → Places API → Credenciais.
# Vazio = sourcing automático desligado (import manual pelo painel continua).
GOOGLE_PLACES_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 8. OPCIONAIS — todos têm default sensato no código
# ─────────────────────────────────────────────────────────────────────────────

# Tiers de modelo (slugs OpenRouter; raciocine por TIER, não por versão).
ROCA_ROUTER_MODEL=anthropic/claude-haiku-4.5
ROCA_REASONING_MODEL=anthropic/claude-sonnet-5
ROCA_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Juiz das avaliações (gym e golden set). DEVE ser de família diferente da que
# gera as respostas — um juiz da mesma família abençoa o próprio estilo e infla
# a métrica. Default: google/gemini-2.5-flash.
ROCA_JUDGE_MODEL=

# Rate limit dos endpoints públicos (/api/card, /api/qr...), por IP e por
# instância. Defaults: 120 requisições por 60000 ms.
PUBLIC_RATE_LIMIT=
PUBLIC_RATE_WINDOW_MS=

# Open-Meteo — clima, Delta T da janela de pulverização e alerta de geada.
# SEM esta chave usamos o tier grátis, cujos termos PROÍBEM uso comercial
# ("You may only use the free API services for non-commercial purposes").
# Assinatura em https://open-meteo.com/en/pricing (checkout Stripe, chave sai
# na hora). Setar aqui migra os três call sites de uma vez — nada mais muda.
OPEN_METEO_API_KEY=
